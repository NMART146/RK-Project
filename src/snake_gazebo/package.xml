<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>snake_gazebo</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="enderman9523@gmail.com">cameron</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime: project packages (robot model + controllers config) -->
  <exec_depend>snake_description</exec_depend>
  <exec_depend>snake_bringup</exec_depend>
  <exec_depend>snake_gait</exec_depend>

  <!-- Runtime: Gazebo Harmonic + ros2_control bridge -->
