<?xml version="1.0" encoding="utf-8"?>
<robot name="Snake">

  <gazebo>
    <plugin filename="ign_gazebo-physics-system" name="ignition::gazebo::systems::Physics">
    </plugin>
  </gazebo>

  <!-- Global Material Definition -->
  <material name="blue">
    <color rgba="0.2 0.2 0.7 1.0" />
  </material>

  <!-- Link 1 -->
  <link name="link_1">
    <inertial>
      <origin xyz="0 0 0" rpy="1.6 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.6 0 0" />
      <geometry>
        <mesh filename="package://snake_description/meshes/link_1.stl" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.6 0 0" />
      <geometry>
        <mesh filename="package://snake_description/meshes/link_1.stl" />
      </geometry>
    </collision>
  </link>

  <!-- Link 2 -->
