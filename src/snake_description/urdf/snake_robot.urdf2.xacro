    </collision>
  </link>

  <!-- Joint 12 -->
  <joint name="joint_12" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="link_1" />
    <child link="link_2" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="1.0" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>

