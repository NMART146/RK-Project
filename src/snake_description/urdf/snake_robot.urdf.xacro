<?xml version="1.0"?>
<!-- Snake Description File -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="snakebot">
  <xacro:arg name="gazebo" default="false"/>

  <!-- Import Snake Description File -->
  <xacro:include filename="$(find snake_description)/urdf/snake_robot_description.urdf.xacro"/>

  <!-- Import ros2_control hardware description -->
  <xacro:include filename="$(find snake_description)/urdf/snake_control.urdf.xacro" />
  <xacro:snake_ros2_control gazebo="$(arg gazebo)"/>

  <xacro:include filename="$(find snake_description)/urdf/snake_gazebo.urdf.xacro" />
  <xacro:gazebo_friction_setup link_name="link_1"/>
  <xacro:gazebo_friction_setup link_name="link_2"/>
  <xacro:gazebo_friction_setup link_name="link_3"/>
  <xacro:gazebo_friction_setup link_name="link_4"/>
  <xacro:gazebo_friction_setup link_name="link_5"/>
  <xacro:gazebo_friction_setup link_name="link_6"/>
  <xacro:gazebo_friction_setup link_name="link_7"/>
  <xacro:gazebo_friction_setup link_name="link_8"/>
  <xacro:gazebo_friction_setup link_name="link_9"/>
  <xacro:gazebo_friction_setup link_name="link_10"/>
</robot>
