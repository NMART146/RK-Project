<?xml version="1.0"?>
<!-- Snake Description File -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="snakebot">
  <xacro:arg name="gazebo" default="false"/>

  <!-- Import Snake Description File -->
  <xacro:include filename="$(find snake_description)/urdf/snake_robot_description.urdf.xacro"/>

  <!-- Import ros2_control hardware description -->
  <xacro:include filename="$(find snake_description)/urdf/snake_control.urdf.xacro" />
  <xacro:snake_ros2_control gazebo="$(arg gazebo)"/>

</robot>
