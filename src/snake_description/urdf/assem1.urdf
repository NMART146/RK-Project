  <!-- ==================== GAZEBO CONTROLLERS ==================== -->

  <gazebo>
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint_12</joint_name>
      <topic>/assem1/joint_12/cmd_pos</topic>
      <p_gain>50</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>1.0</d_gain>
