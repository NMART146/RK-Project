<?xml version="1.0" encoding="utf-8"?>
<robot name="Assem1" xmlns:ignition="http://gazebosim.org/schema">

  <material name="snake_grey">
    <color rgba="0.792156862745098 0.8 0.9 1" />
  </material>

  <!-- link and joint definitions -->

  <link name="link_1">
    <inertial>
      <origin xyz="-0.05 0 0" rpy="0 0 0" />
      <mass value="0.141502212856218" />
      <inertia
        ixx="2.94169063927569E-05" ixy="0" ixz="0"
        iyy="0.000177066188533302" iyz="0"
        izz="0.000177593059801247" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <mesh filename="package://assem1_description/meshes/link_1.stl" />
      </geometry>
      <material name="snake_grey" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry>
        <mesh filename="package://assem1_description/meshes/link_1.stl" />
      </geometry>
    </collision>
  </link>

